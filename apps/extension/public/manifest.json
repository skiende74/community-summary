{
  "manifest_version": 3, "name": "커뮤니티 댓글 요약", "version": "0.2.3",
  "description": "커뮤니티 댓글을 요약하고 사이트별 추출 규칙을 저장합니다.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://*/*", "http://127.0.0.1:4318/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{
    "matches": ["https://*/*"],
    "exclude_matches": ["https://community-summary-api.vercel.app/*"],
    "js": ["content.js"], "run_at": "document_idle"
  }],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": {
    "default_title": "댓글 요약", "default_popup": "popup.html",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" }
  }
}
